{
	"info": {
		"name": "Incident Hub",
		"description": "Contratos de specs/spec-incidents.md. Variaveis baseUrl e incidentId ja vem na colecao (Edit > Variables) - ajuste incidentId conforme os ids seedados no seu banco.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000/api" },
		{ "key": "incidentId", "value": "1" }
	],
	"item": [
		{
			"name": "Dashboard",
			"item": [
				{
					"name": "Resumo (contagens)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/dashboard", "host": ["{{baseUrl}}"], "path": ["dashboard"] }
					}
				}
			]
		},
		{
			"name": "Incidentes",
			"item": [
				{
					"name": "Criar incidente",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Payment API instability\",\n  \"description\": \"Payment API returning intermittent errors during checkout.\",\n  \"severity\": \"Critical\",\n  \"owner\": \"Ana\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/incidents", "host": ["{{baseUrl}}"], "path": ["incidents"] }
					}
				},
				{
					"name": "Criar incidente - erro de validacao (title vazio)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"\",\n  \"description\": \"curto\",\n  \"severity\": \"Low\",\n  \"owner\": \"\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/incidents", "host": ["{{baseUrl}}"], "path": ["incidents"] }
					}
				},
				{
					"name": "Listar incidentes",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/incidents", "host": ["{{baseUrl}}"], "path": ["incidents"] }
					}
				},
				{
					"name": "Listar incidentes - filtro por severidade",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/incidents?severity=Critical",
							"host": ["{{baseUrl}}"], "path": ["incidents"],
							"query": [{ "key": "severity", "value": "Critical" }]
						}
					}
				},
				{
					"name": "Listar incidentes - filtro por status",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/incidents?status=In Progress",
							"host": ["{{baseUrl}}"], "path": ["incidents"],
							"query": [{ "key": "status", "value": "In Progress" }]
						}
					}
				},
				{
					"name": "Detalhar incidente (com historico)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}", "host": ["{{baseUrl}}"], "path": ["incidents", "{{incidentId}}"] }
					}
				},
				{
					"name": "Detalhar incidente - nao encontrado (404)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/incidents/999999", "host": ["{{baseUrl}}"], "path": ["incidents", "999999"] }
					}
				}
			]
		},
		{
			"name": "Transicao de status",
			"item": [
				{
					"name": "Open -> In Progress (permitido)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"In Progress\"\n}" },
						"url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}/status", "host": ["{{baseUrl}}"], "path": ["incidents", "{{incidentId}}", "status"] }
					}
				},
				{
					"name": "In Progress -> Resolved (permitido)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"Resolved\"\n}" },
						"url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}/status", "host": ["{{baseUrl}}"], "path": ["incidents", "{{incidentId}}", "status"] }
					}
				},
				{
					"name": "Critical Open -> Resolved direto (422, regra critica)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"Resolved\"\n}" },
						"url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}/status", "host": ["{{baseUrl}}"], "path": ["incidents", "{{incidentId}}", "status"] }
					}
				},
				{
					"name": "Status invalido (422)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"Closed\"\n}" },
						"url": { "raw": "{{baseUrl}}/incidents/{{incidentId}}/status", "host": ["{{baseUrl}}"], "path": ["incidents", "{{incidentId}}", "status"] }
					}
				}
			]
		}
	]
}
